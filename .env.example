# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 eczanerede.com
CSRF_TRUSTED_ORIGINS=https://eczanerede.com https://www.eczanerede.com

# Google Maps (required in production)
GOOGLE_MAPS_API_KEY=
# Required in production — create a JavaScript/Vector Map ID in Google Cloud.
# Local/dev may omit this and fall back to DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=
ALLOWED_REFERERS=https://eczanerede.com https://www.eczanerede.com

# Database (PostGIS)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/0

# Optional
SENTRY_DSN=
REMOTE_DEBUGGING_PORT=5678

# Production HTTPS (behind Coolify / TLS-terminating proxy)
DJANGO_ENABLE_SECURE_PROXY_SSL_HEADER=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# Rate limiting. Commented lines show the code default; uncomment to override.
# Redis URL for the rate-limit cache (default: CELERY_BROKER_URL).
# RATELIMIT_CACHE_URL=redis://:CHANGE_ME@redis:6379/1
# PHARMACY_POINTS_RATE_LIMIT=30/m
# 0 keys on REMOTE_ADDR; N trusts the Nth-from-right X-Forwarded-For entry.
# RATELIMIT_TRUSTED_PROXY_COUNT=0

# Alternative to the DB_* variables above. The DB_* variables override its parts.
# DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/postgres

# Path of the dotenv file to load (default: .env).
# DOTENV_PATH=.env

# Docker Compose host ports for the dev stack (compose defaults shown).
# DJANGO_HOST_PORT=8000
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# FLOWER_HOST_PORT=5555
# REMOTE_DEBUGGING_HOST_PORT=5678
# Basic auth for Flower in production, as user:password.
# FLOWER_BASIC_AUTH=
